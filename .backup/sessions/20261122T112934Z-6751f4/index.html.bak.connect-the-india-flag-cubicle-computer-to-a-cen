  function nearestEvidence() {
    if (!scene || dlg || evidenceViewer.style.display === 'flex' || computerViewer.style.display === 'flex' || document.getElementById('debriefOverlay').style.display === 'flex') return null;
    const px = (player.x + PW / 2) / U, py = (player.y + PH / 2) / U;
    let best = null, bd = 14;
    const active = getActiveCase();
    if (active && active.status !== 'locked' && active.status !== 'resolved') {
      for (const item of active.evidence) {
        if (collectedEvidence.has(item.id)) continue;
        const d = Math.hypot(item.x - px, item.y - py);
        if (d <= bd) { bd = d; best = { item, caseData:active, distance:d, kind:'evidence' }; }
      }
    } else if (!active) {
      const task = OFFICE_TASKS.find(item => !completedOfficeTasks.has(item.id));
      if (task) {
        const d = Math.hypot(task.x - px, task.y - py);
        // Give every office task object a more forgiving interaction range.
        const interactionRadius = 28;
        if (d <= interactionRadius) best = { item:task, task, distance:d, kind:'task' };
      }
    }
    return best;
  }
  function nearestNpc() {
    if (!scene) return null;
    const activeCase = getActiveCase();
    const eligible = activeCase ? [activeCase] : [];
    const fx = (player.x + PW / 2) / U, fy = (player.y + PH / 2) / U;
    let best = null, bestDistance = TALK_RANGE;
    eligible.forEach(c => {
      const n = NPCS[c.npcIndex];
      const distance = Math.hypot(n.cx - fx, (n.feet - 1) - fy);
      if (distance <= bestDistance) { best = n; bestDistance = distance; }
    });
    return best;
  }
