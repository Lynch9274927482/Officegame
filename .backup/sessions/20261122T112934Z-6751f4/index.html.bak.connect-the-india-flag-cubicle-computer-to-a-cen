<script>
(() => {
  // ================= CONFIG (tweak here) =================
  const IMAGES      = ['LargePixelOffice.png', 'PixelOffice.png']; // scene image (tries in order)
  const ART_W       = 256;   // the office is drawn on a 256-wide pixel grid ("art pixels")
  const P_ART_W = 8, P_ART_H = 3; // player feet hitbox, in art pixels
  const SPEED_ART   = 55;    // walking speed, art pixels per second
  const VIEW_ART_H  = 96;    // art pixels visible vertically (player is 24 tall => 1/4 of the screen)
  const FLOOR_MATCH = 0.8;   // fraction of a cell that must be blue floor to be walkable
  const BLUE_MIN = 160, BLUE_MAX = 260; // hue range (degrees) counted as floor: cyan to blue
  const BLUE_SAT = 0.12;     // minimum saturation to count as blue

  // People removed from the scene (pets stay). [x0,y0,x1,y1, dx,dy] in art pixels:
  // the box is replaced by the clean area located at (+dx,+dy).
  const PATCHES = [
    [69, 99, 87, 126,  95,   0],   // man by the wall
    [221,135,243,161, -111,  0],   // woman with ponytail
    [43, 166, 56, 189,   0, -30],  // man with glasses (seated)
    [112,168,127,192,   0, -32],   // red-haired girl
    [107,168,112,181,   0, -30],
    [107,181,112,192,   0, -32],
    [128,168,147,194, -112,  0]    // dark-haired girl
  ];
  const FILLS = [[44, 167, 51, 175, '#94b0c2']]; // leftover sticky notes -> wall colour

  // Blue objects that must still block (art pixels): water cooler, elevator door, bin
  const BLOCKERS = [[25, 100, 36, 120], [110, 80, 144, 113], [220, 104, 231, 120]];
  // ========================================================

  // People you can talk to (art pixels: cx = centre x, top = top of head, feet = bottom).
  // Edit the lines to write real dialogue.
  const TALK_RANGE = 18;
  const DEBUG = /[?&]debug=1/.test(location.search);   // add ?debug=1 to the address to see collisions
  const PLACEHOLDER = ['Hi there! This is a placeholder dialogue.', 'Replace these lines with your own story.'];
  const NPCS = [
    { name: 'Ethan Garcia', cx: 77, top: 100, feet: 125, lines: ['I often stay late to finish my work, but I am not paid for those extra hours.', 'Can you check my time records and payslip?'] },
    { name: 'Daniel Reyes', cx: 230, top: 135, feet: 159, lines: ['The machine near us has a broken safety guard.', 'Someone could get hurt. Please check the safety and equipment records.'] },
    { name: 'Samuel Cruz', cx: 49, top: 167, feet: 188, lines: ['My payslip shows SSS deductions, but I do not know if the money was sent to SSS.', 'Please compare the payslip deductions with the SSS payment records.'] },
    { name: 'Maya Santos', cx: 116, top: 169, feet: 192, lines: ['Some of us still have not received our 13th-month pay.', 'Can you check the pay summary and payment records?'] },
    { name: 'Chloe Mendoza', cx: 137, top: 169, feet: 192, lines: ['I had to work on my day off, but I am not sure if I got the right extra pay.', 'Please check the work schedule and pay records.'] }
  ];

  const canvas = document.getElementById('game');
  const ctx = canvas.getContext('2d');
  const toastEl = document.getElementById('toast');
  const evidenceViewer = document.getElementById('evidenceViewer');
  const evidenceDocument = document.getElementById('evidenceDocument');

  let img = null, scene = null, W = 0, H = 0;
  let U = 4, CELL = 2, PW = 32, PH = 12, SPEED = 220;   // set in setup() from the image size
  let walk = null, gw = 0, gh = 0;
  const player = { x: 0, y: 0, dir: 'down', moving: false, t: 0 };

  let soundEnabled = true, audioCtx = null, footstepTimer = 0;
  const officeAmbience = document.getElementById('officeAmbience');
  officeAmbience.volume = 0.32;
  let ambienceStarted = false;
  function startOfficeAmbience() {
    if (dlg || !officeAmbience || ambienceStarted) return;
    ambienceStarted = true;
    const playback = officeAmbience.play();
    if (playback && typeof playback.catch === 'function') playback.catch(() => { ambienceStarted = false; });
  }
  function pauseOfficeAmbience() { if (officeAmbience) officeAmbience.pause(); }
  function resumeOfficeAmbience() {
    if (!officeAmbience || dlg) return;
    if (!ambienceStarted) startOfficeAmbience();
    else officeAmbience.play().catch(() => {});
  }
  function playSfx(type = 'ui') {
    if (!soundEnabled) return;
    try {
      const AudioContextClass = window.AudioContext || window.webkitAudioContext;
      if (!AudioContextClass) return;
      if (!audioCtx) audioCtx = new AudioContextClass();
      if (audioCtx.state === 'suspended') audioCtx.resume();
      const now = audioCtx.currentTime;
      const presets = {
        ui:[520,680,.07,'square'], dialogue:[620,760,.055,'sine'], collect:[740,1040,.16,'sine'],
        task:[520,780,.22,'triangle'], good:[520,660,.28,'triangle'], bad:[260,180,.32,'sawtooth'],
        save:[600,820,.14,'sine'], load:[420,620,.18,'sine'], error:[180,130,.22,'square'],
        panel:[430,540,.09,'triangle'], audit:[440,660,.4,'triangle'], slide:[560,700,.08,'sine'], step:[105,58,.075,'triangle'], type:[920,680,.028,'square']
      };
      const [start,end,duration,wave] = presets[type] || presets.ui;
      const osc = audioCtx.createOscillator(), gain = audioCtx.createGain();
      osc.type = wave; osc.frequency.setValueAtTime(start,now); osc.frequency.exponentialRampToValueAtTime(Math.max(40,end),now+duration);
      gain.gain.setValueAtTime(type === 'step' ? .055 : type === 'type' ? .014 : .07,now); gain.gain.exponentialRampToValueAtTime(.001,now+duration);
      osc.connect(gain); gain.connect(audioCtx.destination); osc.start(now); osc.stop(now+duration);
    } catch (error) { /* Audio is optional; gameplay continues without it. */ }
  }
  document.getElementById('sfxToggle').addEventListener('pointerdown', e => {
    e.preventDefault(); soundEnabled = !soundEnabled;
    document.getElementById('sfxToggle').textContent = soundEnabled ? 'SFX ON' : 'SFX OFF';
    if (soundEnabled) playSfx('ui');
  });
  function toast(msg, ms = 4000, kind = '') {
    toastEl.textContent = msg;
    toastEl.classList.toggle('goodDecision', kind === 'good');
    toastEl.style.display = 'block';
    clearTimeout(toast._t); toast._t = setTimeout(() => {
      toastEl.style.display = 'none';
      toastEl.classList.remove('goodDecision');
    }, ms);
  }

  function loadImage(i = 0) {
    if (i >= IMAGES.length) { toast('Could not load the office picture'); return; }
    const im = new Image();
    im.onload = () => { img = im; W = im.naturalWidth; H = im.naturalHeight; setup(); };
    im.onerror = () => loadImage(i + 1);
    im.src = IMAGES[i];
  }

  // ---------- scene with the people painted out ----------
  function buildScene() {
    scene = document.createElement('canvas'); scene.width = W; scene.height = H;
    const c = scene.getContext('2d'); c.imageSmoothingEnabled = false;
    c.drawImage(img, 0, 0);
    for (const [x0, y0, x1, y1, dx, dy] of PATCHES)
      c.drawImage(img, (x0 + dx) * U, (y0 + dy) * U, (x1 - x0) * U, (y1 - y0) * U,
                       x0 * U, y0 * U, (x1 - x0) * U, (y1 - y0) * U);
    for (const [x0, y0, x1, y1, col] of FILLS) {
      c.fillStyle = col; c.fillRect(x0 * U, y0 * U, (x1 - x0) * U, (y1 - y0) * U);
    }
  }

  // ---------- collision grid ----------
  function setup() {
    U = W / ART_W; CELL = Math.max(1, U / 2);
    PW = P_ART_W * U; PH = P_ART_H * U; SPEED = SPEED_ART * U;
    buildScene();
    gw = Math.ceil(W / CELL); gh = Math.ceil(H / CELL);
    walk = null;
    try {
      const c = document.createElement('canvas'); c.width = W; c.height = H;
      const x = c.getContext('2d', { willReadFrequently: true });
      x.drawImage(scene, 0, 0);
      const d = x.getImageData(0, 0, W, H).data;

      const isFloor = i => {
        if (d[i + 3] < 200) return false;
        const r = d[i], g = d[i + 1], b = d[i + 2];
        const mx = Math.max(r, g, b), mn = Math.min(r, g, b), dl = mx - mn;
        if (mx < 50 || dl === 0 || dl / mx < BLUE_SAT) return false;
        let h = mx === r ? ((g - b) / dl) % 6 : mx === g ? (b - r) / dl + 2 : (r - g) / dl + 4;
        h *= 60; if (h < 0) h += 360;
        return h >= BLUE_MIN && h <= BLUE_MAX;
      };

      // raw walkable cells (blue floor)
      const raw = new Uint8Array(gw * gh);
      for (let cy = 0; cy < gh; cy++) for (let cx = 0; cx < gw; cx++) {
        let f = 0, n = 0;
        for (let py = cy * CELL; py < Math.min(H, (cy + 1) * CELL); py++)
          for (let px = cx * CELL; px < Math.min(W, (cx + 1) * CELL); px++) { n++; if (isFloor((py * W + px) * 4)) f++; }
        raw[cy * gw + cx] = n && f / n >= FLOOR_MATCH ? 1 : 0;
      }
      // blue objects that must block
      for (const [x0, y0, x1, y1] of BLOCKERS)
        for (let cy = Math.floor(y0 * U / CELL); cy < Math.min(gh, Math.ceil(y1 * U / CELL)); cy++)
          for (let cx = Math.floor(x0 * U / CELL); cx < Math.min(gw, Math.ceil(x1 * U / CELL)); cx++) raw[cy * gw + cx] = 0;

      // cells where the feet hitbox fits -> pick spawn closest to the centre
      const bw = Math.ceil(PW / CELL) + 1, bh = Math.ceil(PH / CELL) + 1;
      let seed = -1, best = 1e12;
      for (let cy = 0; cy < gh - bh; cy++) for (let cx = 0; cx < gw - bw; cx++) {
        let ok = true;
        for (let j = 0; j < bh && ok; j++) for (let i = 0; i < bw; i++) if (!raw[(cy + j) * gw + cx + i]) { ok = false; break; }
        if (!ok) continue;
        const dx = cx - gw / 2, dy = cy - gh / 2, dd = dx * dx + dy * dy;
        if (dd < best) { best = dd; seed = cy * gw + cx; }
      }
      if (seed < 0) throw new Error('no floor');

      // keep only floor connected to the spawn (office interior)
      const reach = new Uint8Array(gw * gh), q = [seed]; reach[seed] = 1; let size = 0;
      while (q.length) {
        const i = q.pop(); size++;
        const cx = i % gw, cy = (i / gw) | 0;
        for (const [ax, ay] of [[1, 0], [-1, 0], [0, 1], [0, -1]]) {
          const nx = cx + ax, ny = cy + ay;
          if (nx < 0 || ny < 0 || nx >= gw || ny >= gh) continue;
          const n = ny * gw + nx;
          if (raw[n] && !reach[n]) { reach[n] = 1; q.push(n); }
        }
      }
      walk = reach;
      player.x = (seed % gw) * CELL;
      player.y = ((seed / gw) | 0) * CELL;
      if (savedPos) { const nx = savedPos.x * U, ny = savedPos.y * U; if (free(nx, ny)) { player.x = nx; player.y = ny; } }
      if (size < 50) toast('Floor detection may be inaccurate.');
    } catch (e) {
      walk = null;
      player.x = W / 2 - PW / 2; player.y = H / 2 - PH / 2;
      toast('Open the game through the LAN server for proper wall collisions.', 8000);
    }
  }

  function free(x, y) {
    if (!walk) return x >= 0 && y >= 0 && x + PW <= W && y + PH <= H;
    const cx0 = Math.floor(x / CELL), cx1 = Math.floor((x + PW - .001) / CELL);
    const cy0 = Math.floor(y / CELL), cy1 = Math.floor((y + PH - .001) / CELL);
    for (let cy = cy0; cy <= cy1; cy++) for (let cx = cx0; cx <= cx1; cx++)
      if (cx < 0 || cy < 0 || cx >= gw || cy >= gh || !walk[cy * gw + cx]) return false;
    return true;
  }

  // ---------- input ----------
  const keys = { up: false, down: false, left: false, right: false };

  for (const k of ['up', 'down', 'left', 'right']) {
    const el = document.getElementById(k);
    const on  = e => { e.preventDefault(); keys[k] = true;  el.classList.add('on'); };
    const off = e => { e.preventDefault(); keys[k] = false; el.classList.remove('on'); };
    el.addEventListener('pointerdown', on);
    el.addEventListener('pointerup', off);
    el.addEventListener('pointercancel', off);
    el.addEventListener('pointerleave', off);
    el.addEventListener('contextmenu', e => e.preventDefault());
  }
  document.getElementById('fs').addEventListener('click', () => {
    playSfx('ui');
    const el = document.documentElement;
    if (document.fullscreenElement) document.exitFullscreen();
    else if (el.requestFullscreen) {
      el.requestFullscreen().then(() => screen.orientation && screen.orientation.lock && screen.orientation.lock('landscape').catch(() => {})).catch(() => {});
    }
  });
  document.addEventListener('gesturestart', e => e.preventDefault());
  document.addEventListener('dblclick', e => e.preventDefault());

  function resize() {
    const dpr = window.devicePixelRatio || 1;
    canvas.width = Math.round(innerWidth * dpr);
    canvas.height = Math.round(innerHeight * dpr);
  }
  addEventListener('resize', resize); resize();

  // ---------- update ----------
  function update(dt) {
    let dx = (keys.right ? 1 : 0) - (keys.left ? 1 : 0);
    let dy = (keys.down ? 1 : 0) - (keys.up ? 1 : 0);
    if (dlg || evidenceViewer.style.display === 'flex' || computerViewer.style.display === 'flex' || document.getElementById('debriefOverlay').style.display === 'flex' || document.getElementById('reportPreview').style.display === 'block' || document.getElementById('completionScreen').style.display === 'flex') { player.moving = false; return; }
    player.moving = !!(dx || dy);
    if (!player.moving) return;
    if (dx && dy) { dx *= Math.SQRT1_2; dy *= Math.SQRT1_2; }
    if (Math.abs(dx) > Math.abs(dy)) player.dir = dx > 0 ? 'right' : 'left';
    else player.dir = dy > 0 ? 'down' : 'up';
    player.t += dt;
    const oldX = player.x, oldY = player.y;
    const total = SPEED * dt, steps = Math.max(1, Math.ceil(total / (U / 2)));
    const sx = dx * total / steps, sy = dy * total / steps;
    for (let i = 0; i < steps; i++) {
      if (sx && free(player.x + sx, player.y)) player.x += sx;
      if (sy && free(player.x, player.y + sy)) player.y += sy;
    }
    if (player.x !== oldX || player.y !== oldY) {
      footstepTimer += dt;
      if (footstepTimer >= .32) { playSfx('step'); footstepTimer = 0; }
    } else { footstepTimer = 0; }
  }

  // ---------- draw ----------
  function draw() {
    const cw = canvas.width, ch = canvas.height;
    ctx.imageSmoothingEnabled = false;
    ctx.fillStyle = '#111'; ctx.fillRect(0, 0, cw, ch);
    if (!scene) return;

    // zoom: whole number of screen pixels per art pixel, so the player (24 art px tall) is ~1/4 of the screen
    const artScale = Math.max(1, Math.round(ch / VIEW_ART_H));
    const s = artScale / U;                       // device px per source px
    const vw = cw / s, vh = ch / s;
    let camX = player.x + PW / 2 - vw / 2, camY = player.y + PH / 2 - vh / 2;
    camX = W <= vw ? -(vw - W) / 2 : Math.max(0, Math.min(W - vw, camX));
    camY = H <= vh ? -(vh - H) / 2 : Math.max(0, Math.min(H - vh, camY));
    camX = Math.round(camX * s) / s; camY = Math.round(camY * s) / s;

    const sx = v => Math.round((v - camX) * s), sy = v => Math.round((v - camY) * s);
    ctx.drawImage(img, sx(0), sy(0), W * s, H * s); // original scene, people included (collisions use the people-free `scene`)

    // player: 14 x 24 art pixels, same size as the office people
    const px = Math.round((player.x + PW / 2) / U - 7) * U;
    const py = Math.round((player.y + PH) / U - 24) * U;
    const R = (x, y, w, h, c) => { ctx.fillStyle = c; ctx.fillRect(sx(px + x * U), sy(py + y * U), w * artScale, h * artScale); };
    const frame = Math.floor(player.t * 8) % 2;
    const Ll = 4 - (player.moving && frame === 1 ? 1 : 0), Lr = 4 - (player.moving && frame === 0 ? 1 : 0);
    const HAIR = '#4a3022', SKIN = '#f1c27d', SHIRT = '#3b7dd8', SLEEVE = '#2f63b0', PANTS = '#2b2b3a';
    R(1, 22, 12, 2, 'rgba(0,0,0,.25)');                       // shadow
    R(3, 18, 3, Ll, PANTS); R(8, 18, 3, Lr, PANTS);           // legs
    R(2, 18 + Ll, 4, 2, '#111'); R(8, 18 + Lr, 4, 2, '#111'); // shoes
    R(1, 10, 12, 8, SHIRT);                                   // torso
    R(0, 11, 1, 6, SLEEVE); R(13, 11, 1, 6, SLEEVE);          // arms
    R(0, 17, 1, 1, SKIN); R(13, 17, 1, 1, SKIN);              // hands
    R(3, 4, 8, 6, SKIN);                                      // face
    R(2, 0, 10, 4, HAIR); R(2, 4, 1, 3, HAIR); R(11, 4, 1, 3, HAIR); // hair
    if (player.dir === 'down')       { R(4, 6, 2, 2, '#222'); R(8, 6, 2, 2, '#222'); R(6, 9, 2, 1, '#b5584a'); }
    else if (player.dir === 'left')  { R(3, 6, 2, 2, '#222'); R(6, 6, 2, 2, '#222'); }
    else if (player.dir === 'right') { R(6, 6, 2, 2, '#222'); R(9, 6, 2, 2, '#222'); }
    else                             { R(2, 0, 10, 10, HAIR); }

    // Show one active red "!" at a time; resolved coworkers keep a green check.
    const A = (x, y, w, h, c) => { ctx.fillStyle = c; ctx.fillRect(sx(Math.round(x) * U), sy(Math.round(y) * U), w * artScale, h * artScale); };
    const bob = Math.floor(performance.now() / 350) % 2;
    const activeCase = getActiveCase();
    for (const n of NPCS) {
      const c = CASES.find(item => item.npcIndex === NPCS.indexOf(n));
      const y0 = n.top - 13 - bob;
      if (c && c.status === 'resolved') {
        // Green pixel check mark.
        A(n.cx - 4, y0 + 3, 3, 3, '#173c2c');
        A(n.cx - 3, y0 + 4, 2, 2, '#55e08b');
        A(n.cx - 1, y0 + 6, 3, 3, '#55e08b');
        A(n.cx + 1, y0 + 3, 3, 3, '#55e08b');
        continue;
      }
      if (!activeCase || c !== activeCase) continue;
      if (dlg && dlg.npc === n) {
        A(n.cx - 6, y0 + 1, 13, 9, '#262b44'); A(n.cx - 5, y0 + 2, 11, 7, '#fff');
        A(n.cx - 3, y0 + 5, 1, 2, '#262b44'); A(n.cx, y0 + 5, 1, 2, '#262b44'); A(n.cx + 3, y0 + 5, 1, 2, '#262b44');
        continue;
      }
      A(n.cx - 3, y0 - 1, 7, 12, '#262b44'); A(n.cx - 2, y0, 5, 10, '#fff');
      A(n.cx - 1, y0 + 1, 3, 5, '#e43b44'); A(n.cx - 1, y0 + 7, 3, 2, '#e43b44');
    }

    // Gold evidence markers appear only for the active investigation.
    const evidenceCase = getActiveCase();
    if (evidenceCase && evidenceCase.status !== 'locked') for (const item of evidenceCase.evidence) {
      if (collectedEvidence.has(item.id)) continue;
      const ex = item.x, ey = item.y;
      A(ex - 3, ey - 4, 7, 8, '#292d3e'); A(ex - 2, ey - 3, 5, 6, '#f2d27a');
      A(ex - 1, ey - 2, 3, 1, '#80652b'); A(ex - 1, ey, 3, 1, '#80652b');
      // Tiny red down-arrow above every uncollected evidence document.
      const ay = ey - 14 - bob;
      A(ex - 1, ay, 3, 4, '#e43b44');
      A(ex - 3, ay + 2, 2, 2, '#e43b44');
      A(ex + 2, ay + 2, 2, 2, '#e43b44');
    }

    if (DEBUG && walk) {
      ctx.fillStyle = 'rgba(255,0,0,.35)';
      const gx0 = Math.max(0, Math.floor(camX / CELL)), gx1 = Math.min(gw, Math.ceil((camX + vw) / CELL));
      const gy0 = Math.max(0, Math.floor(camY / CELL)), gy1 = Math.min(gh, Math.ceil((camY + vh) / CELL));
      for (let cy = gy0; cy < gy1; cy++) for (let cx = gx0; cx < gx1; cx++)
        if (!walk[cy * gw + cx]) ctx.fillRect(sx(cx * CELL), sy(cy * CELL), Math.ceil(CELL * s), Math.ceil(CELL * s));
      ctx.strokeStyle = '#0f0'; ctx.lineWidth = 2; ctx.strokeRect(sx(player.x), sy(player.y), PW * s, PH * s);
      ctx.fillStyle = '#0ff';
      for (const it of [...CASES.flatMap(c => c.evidence), ...OFFICE_TASKS]) ctx.fillRect(sx(it.x * U) - 3, sy(it.y * U) - 3, 6, 6);
    }

    // Mark the next office task with a small red exclamation point.
    const nextOfficeTask = OFFICE_TASKS.find(task => !completedOfficeTasks.has(task.id));
    if (nextOfficeTask && !CASES.some(item => item.status !== 'resolved')) {
