  function loadGame() {
    if (!PERSIST_PROGRESS) { try { localStorage.removeItem(SAVE_KEY); } catch (e) {} return; }
    try {
      if (/[?&]reset=1/.test(location.search)) {
        localStorage.removeItem(SAVE_KEY);
        history.replaceState(null, '', location.pathname);
        return;
      }
      const raw = localStorage.getItem(SAVE_KEY); if (!raw) return;
      const s = JSON.parse(raw);
      (s.evidence || []).forEach(id => collectedEvidence.add(id));
      (s.tasks || []).forEach(id => completedOfficeTasks.add(id));
      (s.computer || []).forEach(id => computerSections.add(id));
      Object.keys(companyStats).forEach(k => { if (s.stats && Number.isFinite(s.stats[k])) companyStats[k] = s.stats[k]; });
      (s.cases || []).forEach(saved => {
        const c = CASES.find(x => x.id === saved.id);
        if (c) { c.status = saved.status || 'locked'; if (saved.outcome) c.outcome = saved.outcome; if (saved.consequence) c.consequence = saved.consequence; }
      });
      activeCaseId = s.active || null;
      journalEntries.length = 0; (s.journal || []).forEach(j => journalEntries.push(j));
      if (s.pos && Number.isFinite(s.pos.x) && Number.isFinite(s.pos.y)) savedPos = s.pos;
    } catch (e) { /* ignore a corrupt or unavailable save */ }
  }
  loadGame(); refreshCasePanel();

  let last = performance.now();
  function loop(now) {
    const dt = Math.min(.05, (now - last) / 1000); last = now;
    update(dt); tick(dt); draw();
    if (now - lastSaveTime > 3000) { lastSaveTime = now; saveGame(); }
    requestAnimationFrame(loop);
  }

  loadImage();
  requestAnimationFrame(loop);
})();
</script>
</body>
</html>
