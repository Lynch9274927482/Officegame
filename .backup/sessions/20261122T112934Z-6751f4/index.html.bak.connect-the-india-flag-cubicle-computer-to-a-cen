<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<title>Pixel Office</title>
<style>
  html, body {
    margin: 0; height: 100%; background: #111; overflow: hidden;
    touch-action: none; user-select: none; -webkit-user-select: none;
    -webkit-touch-callout: none; -webkit-tap-highlight-color: transparent;
    overscroll-behavior: none; font-family: system-ui, sans-serif;
  }
  canvas { position: fixed; inset: 0; width: 100%; height: 100%; display: block; image-rendering: pixelated; }

  /* Keyboard mode hides touch-only controls; touch input restores them. */
  body.keyboard-mode #dpad,
  body.keyboard-mode #talk { display: none !important; }

  #dpad {
    position: fixed;
    left: calc(env(safe-area-inset-left, 0px) + 16px);
    bottom: calc(env(safe-area-inset-bottom, 0px) + 16px);
    --b: clamp(46px, 15vh, 64px);
    display: grid; grid-template-columns: repeat(3, var(--b)); grid-template-rows: repeat(3, var(--b));
    gap: 4px;
  }
  .btn {
    background: rgba(255,255,255,.2); border: 2px solid rgba(255,255,255,.35);
    border-radius: 14px; color: #fff; font-size: calc(var(--b) * .45);
    display: flex; align-items: center; justify-content: center;
    backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px);
  }
  .btn.on { background: rgba(255,255,255,.5); }
  #up    { grid-area: 1 / 2; }
  #left  { grid-area: 2 / 1; }
  #right { grid-area: 2 / 3; }
  #down  { grid-area: 3 / 2; }

  #saveTools { position:fixed; z-index:4; top:calc(env(safe-area-inset-top,0px) + 47px); right:8px; display:flex; gap:5px; }
  #saveTools .tool { width:auto; min-width:43px; height:27px; padding:0 7px; font-size:11px; font-weight:700; background:rgba(16,19,31,.92); }
  #tools {
    position: fixed; top: calc(env(safe-area-inset-top, 0px) + 8px);
    right: calc(env(safe-area-inset-right, 0px) + 8px); display: flex; gap: 6px;
  }
  .tool { width: 40px; height: 32px; font-size: 14px; border-radius: 8px; }
  .tool.wide { width:auto; padding:0 8px; font-size:11px; font-weight:700; }
  .featurePanel { display:none; position:fixed; z-index:7; top:calc(env(safe-area-inset-top,0px) + 48px); right:8px; width:min(390px,62vw); max-height:68vh; overflow:auto; box-sizing:border-box; padding:13px; color:#f5f5f5; background:rgba(16,19,31,.97); border:2px solid #d6d9e5; border-radius:9px; font:11px/1.45 ui-monospace,monospace; touch-action:pan-y; }
  .featurePanel h3 { margin:0 0 9px; color:#ffcd75; font-size:14px; }
  .journalEntry { padding:7px 0; border-top:1px solid rgba(255,255,255,.16); }
  .journalTime { color:#ffcd75; font-size:11px; }
  .journalBody { color:#e5e8f0; margin-top:2px; }
  .discussionCard { padding:9px 0; border-top:1px solid rgba(255,255,255,.16); }
  .discussionCard strong { color:#ffcd75; display:block; margin-bottom:4px; }
  .presenterCard { width:min(850px,92vw); max-height:85vh; overflow:auto; padding:clamp(18px,4vw,38px); box-sizing:border-box; border:2px solid #ffcd75; border-radius:12px; background:#171d30; font:clamp(14px,2vw,20px)/1.5 ui-monospace,monospace; }
  .presenterCard h1 { color:#ffcd75; font-size:clamp(22px,4vw,38px); margin:0 0 18px; }
  .presenterCard h2 { color:#ffcd75; font-size:clamp(16px,2.5vw,24px); }
  .presenterControls { display:flex; justify-content:space-between; align-items:center; gap:8px; margin-top:24px; }
  .presenterBtn { padding:9px 14px; border:1px solid #ffcd75; border-radius:6px; background:#252c40; color:#fff; font:12px ui-monospace,monospace; }
  .auditMetric { padding:7px 0; border-top:1px solid rgba(255,255,255,.16); color:#e5e8f0; }
  .auditMetric strong { color:#ffcd75; }
  .endingCard { margin:10px 0; padding:10px; border:1px solid #ffcd75; border-radius:7px; background:rgba(255,205,117,.08); }
  #completionScreen { display:none; position:fixed; inset:0; z-index:12; align-items:center; justify-content:center; overflow:auto; padding:18px; box-sizing:border-box; background:rgba(3,5,12,.97); color:#fff; }
  .completionCard { width:min(620px,94vw); max-height:90vh; overflow:auto; box-sizing:border-box; padding:clamp(20px,5vw,38px); border:2px solid #ffcd75; border-radius:12px; background:#171d30; text-align:center; font-family:ui-monospace,monospace; }
  .completionEyebrow { color:#ffcd75; font-size:11px; letter-spacing:2px; }
  #completionRating { margin:18px 0 8px; font-size:clamp(27px,6vw,46px); font-weight:900; }
  #completionScore { font-size:clamp(22px,4vw,32px); color:#ffcd75; font-weight:800; }
  #completionStats { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; margin:20px 0; text-align:left; }
  #completionStats div { padding:10px; border:1px solid rgba(255,255,255,.2); border-radius:6px; background:rgba(255,255,255,.05); font-size:11px; }
  #completionDescription { color:#d9deeb; font-size:13px; line-height:1.5; }
  #completionClose, #debriefOpen { margin-top:16px; padding:11px 16px; border:1px solid #ffcd75; border-radius:6px; background:#343d52; color:#fff; font:700 12px ui-monospace,monospace; }
  .completionActions { display:flex; justify-content:center; flex-wrap:wrap; gap:8px; }
  .reportText { white-space:pre-line; color:#e5e8f0; font-size:11px; line-height:1.5; }
  #reportPreview { display:none; position:fixed; inset:0; z-index:11; overflow:auto; padding:12px; box-sizing:border-box; background:rgba(4,6,12,.94); color:#202536; touch-action:pan-y; }
  .reportPreviewBar { position:sticky; top:0; display:flex; justify-content:space-between; gap:8px; padding:8px; margin:0 auto 10px; width:min(760px,96vw); box-sizing:border-box; background:#252b3b; border:1px solid #d5d9e4; border-radius:8px; }
  .reportPreviewBar button { padding:9px 12px; border:1px solid #ffcd75; border-radius:5px; background:#343d52; color:#fff; font:700 11px ui-monospace,monospace; }
  #finalReportPaper { width:min(760px,96vw); min-height:80vh; box-sizing:border-box; margin:0 auto 20px; padding:clamp(18px,4vw,38px); background:#fff; color:#202536; box-shadow:0 4px 20px #0008; font:12px/1.55 Arial,sans-serif; }
  #finalReportPaper h1 { margin:0; color:#17243b; font-size:24px; text-align:center; }
  #finalReportPaper h2 { margin:22px 0 7px; padding-bottom:5px; border-bottom:2px solid #34445f; color:#24334f; font-size:15px; }
  #finalReportPaper h3 { margin:14px 0 5px; color:#34445f; font-size:12px; }
  #finalReportPaper p { margin:5px 0 9px; }
  #finalReportPaper table { width:100%; border-collapse:collapse; margin:8px 0 14px; font-size:11px; }
  #finalReportPaper th,#finalReportPaper td { border:1px solid #b9bfca; padding:6px; text-align:left; vertical-align:top; }
  #finalReportPaper th { background:#e9edf2; }
  .reportMeta { margin:8px 0 18px; color:#58647a; text-align:center; font-size:11px; }
  .reportSign { margin-top:32px; padding-top:8px; border-top:1px solid #aeb5c1; color:#58647a; font-size:11px; }
  .moreTabs { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:5px; margin:0 0 10px; }
  .moreTab { min-height:31px; border:1px solid #7e879b; border-radius:5px; background:#252c40; color:#fff; font:700 11px ui-monospace,monospace; }
  .moreTab.active { border-color:#ffcd75; color:#ffcd75; background:#343d52; }
  .moreCard { margin:7px 0; padding:9px; border:1px solid rgba(255,255,255,.18); border-radius:6px; background:rgba(255,255,255,.04); }
  .moreCard strong { color:#ffcd75; display:block; margin-bottom:4px; }
  .moreMeta { color:#aeb6c8; font-size:11px; margin-bottom:4px; }
  .moreChoice { display:block; width:100%; margin-top:6px; padding:8px; border:1px solid #7e879b; border-radius:5px; background:#252c40; color:#fff; font:11px/1.4 ui-monospace,monospace; text-align:left; }
  .moreChoice:disabled { opacity:.5; }
  .achievementState { float:right; color:#ffcd75; font-size:11px; font-weight:700; }
  #computerViewer { display:none; position:fixed; inset:0; z-index:13; align-items:center; justify-content:center; padding:10px; box-sizing:border-box; background:rgba(4,6,12,.9); color:#fff; touch-action:pan-y; }
  .computerWindow { width:min(720px,96vw); max-height:92vh; overflow:auto; box-sizing:border-box; padding:14px; border:2px solid #d5d9e4; border-radius:10px; background:#171d30; font:12px/1.45 ui-monospace,monospace; }
  .computerTop { display:flex; justify-content:space-between; align-items:center; gap:8px; margin-bottom:10px; color:#ffcd75; font-weight:700; }
  .computerTabs { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:5px; margin-bottom:10px; }
  .computerTab { min-height:34px; padding:5px; border:1px solid #7e879b; border-radius:5px; background:#252c40; color:#fff; font:700 11px ui-monospace,monospace; }
  .computerTab.active { border-color:#ffcd75; color:#ffcd75; }
  .computerPaper { min-height:190px; padding:12px; border-radius:5px; background:#e9edf2; color:#202536; }
  .computerPaper h3 { margin:0 0 8px; color:#24334f; font-size:14px; }
  .computerPaper h4 { margin:12px 0 4px; color:#34445f; }
  .computerPaper p { margin:5px 0; }
  .computerPaper table { width:100%; border-collapse:collapse; margin:8px 0; font-size:11px; }
  .computerPaper th,.computerPaper td { border:1px solid #bcc4d0; padding:5px; text-align:left; }
  .computerPaper th { background:#dce2e9; }
  .computerFooter { display:flex; justify-content:space-between; align-items:center; gap:8px; flex-wrap:wrap; margin-top:10px; }
  .computerAction { padding:9px 12px; border:1px solid #ffcd75; border-radius:5px; background:#343d52; color:#fff; font:700 11px ui-monospace,monospace; }
  #debriefOverlay { display:none; position:fixed; inset:0; z-index:14; align-items:center; justify-content:center; padding:12px; box-sizing:border-box; overflow:auto; background:rgba(3,5,12,.97); color:#fff; }
  .debriefCard { width:min(850px,96vw); max-height:94vh; overflow:auto; box-sizing:border-box; padding:clamp(15px,3vw,28px); border:2px solid #ffcd75; border-radius:10px; background:#171d30; font:12px/1.5 ui-monospace,monospace; touch-action:pan-y; }
  .debriefCard h2,.debriefCard h3 { color:#ffcd75; }
  .debriefCase { padding:10px 0; border-top:1px solid rgba(255,255,255,.18); }
  .debriefCase strong { color:#ffcd75; }
  .debriefQuestions { margin-top:14px; padding:10px; border:1px solid rgba(255,205,117,.4); border-radius:6px; }
  @media (max-width:700px) { .computerTabs { grid-template-columns:repeat(2,minmax(0,1fr)); } .computerWindow { padding:9px; } .computerPaper { padding:9px; } }

  #talk {
    position: fixed; right: calc(env(safe-area-inset-right, 0px) + 24px);
    bottom: calc(env(safe-area-inset-bottom, 0px) + 28px);
    width: clamp(60px, 20vh, 84px); height: clamp(60px, 20vh, 84px);
    border-radius: 50%; font-size: 15px; font-weight: bold; opacity: .55;
  }
  #talk.ready { opacity: 1; background: rgba(228,59,68,.8); border-color: #fff; }

  #dialogueBackdrop { display:none; position:fixed; inset:0; z-index:4; background:rgba(0,0,0,.76); }
  #dialogueStage { display:none; position:fixed; z-index:5; left:50%; bottom:calc(env(safe-area-inset-bottom,0px) + 12px); transform:translateX(-50%); width:min(94vw,900px); align-items:flex-end; justify-content:center; gap:10px; pointer-events:none; }
  #dlgPortrait { display:none; flex:0 0 auto; width:clamp(76px,15vw,132px); height:clamp(104px,25vh,190px); object-fit:contain; object-position:bottom center; image-rendering:pixelated; filter:none; pointer-events:none; }
  #dlg {
    position:relative; left:auto; bottom:auto; transform:none; display:none;
    width:auto; flex:1; max-height:48vh; overflow-y:auto; box-sizing:border-box; padding:12px 16px 18px;
    background:rgba(20,24,40,.98); color:#fff; border:3px solid #fff; border-radius:8px;
    font-family:ui-monospace,Menlo,Consolas,monospace; z-index:5; pointer-events:auto;
  }
  #dlgName { font-size: 12px; font-weight: bold; color: #ffcd75; margin-bottom: 4px; }
  #dlg.badDecision { animation: badDecisionShake .58s ease-in-out; background:rgba(105,12,25,.97); border-color:#ff303f; box-shadow:0 0 0 3px rgba(255,48,63,.25), 0 0 24px rgba(255,30,45,.9); }
  #dlg.goodDecision { background:rgba(12,65,43,.97); border-color:#62c99a; box-shadow:0 0 0 3px rgba(98,201,154,.22), 0 0 24px rgba(45,190,125,.45); }
  @keyframes badDecisionShake {
    0%,100% { transform:translateX(0); }
    12%,36%,60%,84% { transform:translateX(-9px); }
    24%,48%,72% { transform:translateX(9px); }
  }
  #dlgText { font-size: 14px; line-height: 1.35; min-height: 2.7em; }
  #dlgNext { position: sticky; float:right; right: 10px; bottom: 2px; font-size: 11px; color: #ffcd75; }
  #dlgChoices { display:none; margin-top:12px; gap:8px; }
  #dlgChoices.visible { display:grid; grid-template-columns:1fr 1fr; }
  .dlgChoice { min-height:54px; padding:10px; border:2px solid #ffcd75; border-radius:6px; background:#252c40; color:#fff; font:12px/1.4 ui-monospace,monospace; text-align:left; }
  .dlgChoice:active { background:#414c68; }
  @media (max-width:700px) { #dialogueStage { width:96vw; gap:5px; } #dlgPortrait { width:clamp(62px,18vw,92px); height:clamp(90px,22vh,145px); } #dlg { max-height:54vh; padding:10px 12px 16px; } #dlgChoices.visible { grid-template-columns:1fr; } #dlgText { font-size:13px; } }

  #toast {
    position: fixed; top: calc(env(safe-area-inset-top, 0px) + 8px); left: 50%;
    transform: translateX(-50%); background: rgba(0,0,0,.75); color: #fff;
    padding: 6px 12px; border-radius: 8px; font-size: 13px; max-width: 70vw;
    text-align: center; display: none;
  }
  #toast.goodDecision {
    border:2px solid #62c99a; background:rgba(12,65,43,.97);
    color:#e5ffef; font-weight:800; box-shadow:0 0 16px rgba(98,201,154,.35);
  }


  #caseHud { position:fixed; top:calc(env(safe-area-inset-top,0px) + 8px); left:calc(env(safe-area-inset-left,0px) + 8px); z-index:4; }
  #caseToggle { padding:0 12px; min-width:74px; height:34px; border-radius:8px; font-size:12px; font-weight:700; background:rgba(20,24,40,.9); }
  #casePanel { display:none; position:fixed; z-index:6; top:calc(env(safe-area-inset-top,0px) + 50px); left:calc(env(safe-area-inset-left,0px) + 8px); width:min(310px,45vw); max-height:58vh; overflow:auto; box-sizing:border-box; padding:12px; color:#f5f5f5; background:rgba(16,19,31,.96); border:2px solid #d6d9e5; border-radius:9px; font:12px/1.4 ui-monospace,monospace; touch-action:pan-y; }
  #casePanel h3 { margin:0 0 8px; color:#ffcd75; font-size:14px; }
  .caseCard { padding:8px 0; border-top:1px solid rgba(255,255,255,.18); }
  .caseTitle { font-weight:700; color:#fff; }
  .caseStatus { float:right; color:#ffcd75; font-size:11px; }
  .caseDesc { color:#c4c9d8; margin:4px 0; }
  .evidenceLine { color:#b9e6cf; margin:2px 0 0 8px; }
  .evidenceDetail { color:#aeb6c8; margin:1px 0 4px 20px; font-size:11px; }
  #caseCount { color:#ffcd75; }
  #objectiveHud { position:fixed; top:calc(env(safe-area-inset-top,0px) + 48px); left:calc(env(safe-area-inset-left,0px) + 8px); z-index:3; width:min(330px,48vw); padding:7px 10px; box-sizing:border-box; border:1px solid rgba(255,255,255,.45); border-radius:7px; background:rgba(16,19,31,.9); color:#fff; font:11px/1.35 ui-monospace,monospace; pointer-events:none; }
  #objectiveLabel { color:#ffcd75; font-weight:700; font-size:11px; margin-bottom:3px; }
  #objectiveText { color:#f1f3f8; }
  @media (pointer:coarse) { #keyboardHint { display:none; } }
  body.keyboard-mode #keyboardHint { display:block !important; }
  #keyboardHint { margin-top:5px; color:#aeb6c8; font-size:11px; letter-spacing:.04em; }
  .statsGrid { display:grid; grid-template-columns:1fr 1fr; gap:7px 12px; margin:8px 0 12px; }
  .statItem { font-size:11px; color:#d5d9e4; }
  .statTrack { height:6px; background:#34394a; border-radius:5px; overflow:hidden; margin-top:3px; }
  .statFill { height:100%; background:#62c99a; }
  .decisionBox { margin-top:7px; padding:7px; background:rgba(255,205,117,.08); border:1px solid rgba(255,205,117,.35); border-radius:6px; }
  .decisionTitle { color:#ffcd75; font-weight:700; margin-bottom:5px; }
  .decisionBtn { display:block; width:100%; margin:5px 0; padding:7px; border:1px solid #7e879b; border-radius:5px; background:#252c40; color:#fff; font:11px/1.4 ui-monospace,monospace; text-align:left; }
  .decisionBtn:active { background:#414c68; }
  .decisionResult { color:#b9e6cf; margin-top:5px; font-size:11px; }
  @media (max-width:700px) { #casePanel { width:min(280px,58vw); max-height:48vh; font-size:11px; } #objectiveHud { width:min(280px,58vw); font-size:11px; } }


  #evidenceViewer { display:none; position:fixed; inset:0; z-index:8; align-items:center; justify-content:center; padding:14px; box-sizing:border-box; background:rgba(4,6,12,.88); color:#202536; touch-action:pan-y; }
  .evidenceWindow { width:min(680px,94vw); max-height:88vh; overflow:auto; box-sizing:border-box; padding:12px; border:2px solid #d5d9e4; border-radius:10px; background:#252b3b; }
  .evidenceTop { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:10px; color:#ffcd75; font:700 12px ui-monospace,monospace; }
  .evidenceClose { flex:none; padding:8px 12px; border:1px solid #ffcd75; border-radius:6px; background:#343d52; color:#fff; font:700 11px ui-monospace,monospace; }
  .evidencePaper { padding:clamp(13px,3vw,24px); background:#f2f0e8; color:#202536; border-radius:4px; box-shadow:0 4px 18px rgba(0,0,0,.3); font:12px/1.45 ui-monospace,monospace; }
  .evidencePaper h2 { margin:0 0 4px; color:#17243b; font-size:clamp(16px,3vw,22px); }
  .evidenceOrg { margin-bottom:14px; color:#536078; font-size:11px; letter-spacing:.08em; }
  .evidenceStamp { display:inline-block; margin:4px 0 12px; padding:3px 7px; border:1px solid #a54b4b; color:#a54b4b; font-size:11px; font-weight:700; transform:rotate(-2deg); }
  .evidenceMeta { display:grid; grid-template-columns:1fr 1fr; gap:7px 14px; padding:9px 0; border-top:1px solid #c8cbd1; border-bottom:1px solid #c8cbd1; font-size:11px; }
  .evidenceMeta b { display:block; color:#59647a; font-size:11px; }
  .evidencePaper h3 { margin:14px 0 5px; color:#24334f; font-size:12px; }
  .evidencePaper p { margin:5px 0; }
  .evidenceTable { width:100%; border-collapse:collapse; margin:8px 0; font-size:11px; }
  .evidenceTable th,.evidenceTable td { padding:6px 5px; border:1px solid #c8cbd1; text-align:left; vertical-align:top; }
  .evidenceTable th { background:#e2e5e9; color:#24334f; }
  .evidenceFinding { margin-top:12px; padding:9px; border-left:3px solid #c18b36; background:#e7e5dc; }
  .evidenceImageBrief { margin-top:12px; padding:10px; border:1px solid #c8cbd1; background:#e8e9e6; }
  .evidenceImageBrief b { display:block; margin-bottom:7px; color:#263754; }
  .evidencePhoto { display:block; width:100%; max-height:360px; object-fit:contain; image-rendering:auto; background:#d9dce1; border:1px solid #aeb5c1; }
  .evidenceFooter { margin-top:14px; padding-top:8px; border-top:1px solid #c8cbd1; color:#59647a; font-size:11px; }
  @media (max-width:700px) { #evidenceViewer { padding:7px; } .evidenceWindow { width:96vw; max-height:91vh; padding:8px; } .evidencePaper { padding:12px; } .evidenceMeta { grid-template-columns:1fr 1fr; } .evidenceTable { font-size:11px; } .evidenceTable th,.evidenceTable td { padding:4px 3px; } }

  #rotate {
    position: fixed; inset: 0; background: #111; color: #fff; display: none;
    align-items: center; justify-content: center; flex-direction: column;
    font-size: 18px; text-align: center; z-index: 10;
  }
  #rotate span { font-size: 48px; margin-bottom: 12px; }
  @media (orientation: portrait) and (pointer: coarse) { #rotate { display: flex; } }
</style>
</head>
<body>
<audio id="officeAmbience" src="freesound_community-office-ambience-6322.mp3" loop preload="auto"></audio>
<canvas id="game"></canvas>

<div id="dpad">
  <div class="btn" id="up">▲</div>
  <div class="btn" id="left">◀</div>
  <div class="btn" id="right">▶</div>
  <div class="btn" id="down">▼</div>
</div>

<div id="tools">
  <div class="btn tool wide" id="sfxToggle">SFX ON</div>
  <div class="btn tool" id="fs">⛶</div>
</div>
<div class="btn" id="talk">TALK</div>
<div id="dialogueBackdrop"></div>
<div id="dialogueStage"><img id="dlgPortrait" alt="Coworker speaking"><div id="dlg"><div id="dlgName"></div><div id="dlgText"></div><div id="dlgChoices"></div><div id="dlgNext">▼</div></div></div>
<div id="toast"></div>

