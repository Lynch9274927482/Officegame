  let savedPos = null, lastSaveTime = 0;
  function saveGame() {
    if (!scene || !PERSIST_PROGRESS) return;
    if (!scene) return;
    try {
      localStorage.setItem(SAVE_KEY, JSON.stringify({
        evidence: [...collectedEvidence], tasks: [...completedOfficeTasks], computer: [...computerSections],
        stats: companyStats, active: activeCaseId, journal: journalEntries,
        cases: CASES.map(c => ({ id: c.id, status: c.status, outcome: c.outcome, consequence: c.consequence })),
